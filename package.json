{
  "name": "ideforfun",
  "version": "0.46.0",
  "description": "A hobby IDE with a hand-written editor",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/test.mjs",
    "dist": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:dir": "electron-vite build && electron-builder --win --x64 --dir --publish never"
  },
  "devDependencies": {
    "@types/node": "24.9.2",
    "electron": "44.7.2",
    "electron-builder": "26.18.0",
    "electron-vite": "5.0.0",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "basedpyright": "1.40.2",
    "electron-updater": "6.6.2",
    "node-pty": "1.1.0",
    "yaml": "2.6.1"
  },
  "author": "louisatron84",
  "homepage": "https://forgecode.uk",
  "build": {
    "appId": "uk.forgecode.forge",
    "productName": "Forge",
    "copyright": "louisatron84",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/basedpyright/**",
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "publish": [{ "provider": "github", "owner": "louisatron84", "repo": "IDEforfun" }],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Forge",
      "artifactName": "Forge-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Forge-${version}-portable.${ext}"
    }
  }
}
